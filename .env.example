# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_KEY: Secure password/secret key required for accessing the admin panel and managing fleet/bank details.
# Must be set by the administrator. Never hard-coded in source code.
ADMIN_KEY="YOUR_ADMIN_PASSWORD_OR_KEY"

# JWT_SECRET: (Optional) Secret key used to sign and verify stateless admin session tokens.
# If omitted, a key derived from ADMIN_KEY is used automatically.
JWT_SECRET="YOUR_JWT_SECRET_KEY"

# ADMIN_EMAILS: Comma-separated list of email addresses authorized for Firebase Admin authentication.
# Example: "admin@zonetourism.ae,owner@hotwheelscarrental.ae"
ADMIN_EMAILS="jilansoftacademy@gmail.com"

# Cloud SQL PostgreSQL Database Credentials
# Automatically provisioned and managed by Cloud SQL integration.
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="zonetourism"

# Company Official Contact Configuration (Optional overrides for production)
COMPANY_EMAIL="admin@zonetourism.ae"
COMPANY_WHATSAPP="971500000000"
COMPANY_PHONE="+971 4 000 0000"
